# Docker Compose reads `.env` automatically. These defaults are intended only
# for the localhost-only laptop stack; choose a strong password before exposing
# PostgreSQL beyond the private Compose network.
APP_UID=1000
APP_GID=1000
POSTGRES_DB=ophanim
POSTGRES_USER=ophanim
POSTGRES_PASSWORD=ophanim-local-only
OPHANIM_PORT=8765
